+    std::fclose(g_capture_file);
+    g_capture_file = nullptr;
+    if (g_capture_ucode_file) {
+      std::fclose(g_capture_ucode_file);
+      g_capture_ucode_file = nullptr;
+    }
+    REXGPU_INFO("[render capture] GPU side: frame {} done, {} draws, {} shaders",
+                g_capture_file_frame, g_capture_sequence, g_capture_ucode_written.size());
+  }
