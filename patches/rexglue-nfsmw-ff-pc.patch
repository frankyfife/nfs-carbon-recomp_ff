+            ui_paint_deferred_.exchange(false, std::memory_order_relaxed)) {
+          RequestPaintOrConnectionRecoveryViaWindow(false);
+        }
+      }
+      dxgi_ui_tick_lock.lock();
+    }
   }
 }
