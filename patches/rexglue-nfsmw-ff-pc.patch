+void D3D12TextureCache::FreeTextureHeapBlock(uint32_t heap_index, uint64_t offset,
+                                             uint64_t size) {
+  if (heap_index >= texture_heaps_.size()) {
+    return;
+  }
+  auto& free_blocks = texture_heaps_[heap_index].free_blocks;
+  auto it = free_blocks.emplace(offset, size).first;
+  // Juntar con el hueco siguiente y con el anterior.
+  auto next = std::next(it);
+  if (next != free_blocks.end() && it->first + it->second == next->first) {
+    it->second += next->second;
+    free_blocks.erase(next);
+  }
+  if (it != free_blocks.begin()) {
+    auto prev = std::prev(it);
+    if (prev->first + prev->second == it->first) {
+      prev->second += it->second;
+      free_blocks.erase(it);
+    }
+  }
